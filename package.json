{
  "name": "flow-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "secret-scan": "tsx scripts/secret-scan.ts",
    "setup:testnet-accounts": "tsx scripts/setup-testnet-accounts.ts",
    "trust-lines": "tsx scripts/trust-lines.ts",
    "preflight": "tsx scripts/preflight.ts",
    "m1:send": "tsx scripts/m1-send-rlusd.ts",
    "lint": "eslint . --max-warnings 0",
    "audit": "pnpm audit --prod",
    "setup:hooks": "tsx scripts/setup-hooks.ts",
    "test:db": "pnpm -r --if-present test:db",
    "db:up": "tsx scripts/db-local.ts up",
    "db:down": "tsx scripts/db-local.ts down",
    "db:status": "tsx scripts/db-local.ts status",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "guard:dev": "tsx scripts/guard-dev.ts",
    "m3:e2e": "tsx scripts/m3-e2e.ts",
    "dev:web": "tsx scripts/dev-web.ts",
    "db:seed:demo": "tsx scripts/seed-demo-owner.ts"
  },
  "dependencies": {
    "dotenv": "18.0.10",
    "xrpl": "5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-plugin-security": "4.2.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
