# Flow AI environment template. Placeholders only: NEVER put real values here.
# Copy to .env (gitignored) per process. Variables are grouped by the process that may read them.

# ---- Shared (non-secret) ----
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# XRPL: Testnet only (read by web for display, guard for execution)
XRPL_NETWORK=xrpl-testnet
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
XRPL_RPC_URL=https://s.altnet.rippletest.net:51234/
RLUSD_DISPLAY_SYMBOL=RLUSD
# Testnet RLUSD currency hex and issuer: found in Ripple docs (docs.ripple.com/products/stablecoin/developer-resources/rlusd-on-the-xrpl).
# Re-verify before each deployment with `pnpm preflight` (spec 19.2).
RLUSD_CURRENCY_HEX=524C555344000000000000000000000000000000
RLUSD_ISSUER=rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV

# ---- Web app + app API only ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=
# Owner web app (M4): connection string for the flow_web role only (never the admin or guard role). Locally pnpm dev:web
# assembles it in memory from .secrets; do not put the real value here.
WEB_DATABASE_URL=
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800
# Owner demo login used by pnpm db:seed:demo (email only here; the password stays in the gitignored .env or .secrets/web-owner.env)
DEMO_OWNER_EMAIL=
PAYMENT_GUARD_INTERNAL_URL=http://localhost:4002

# ---- Payment guard only (policy + signer module) ----
GUARD_DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# MVP default signer: env seed (10.8). With the P1 backstop use the regular-key seed instead.
XRPL_DEMO_SIGNER_SEED=
XRPL_REGULAR_KEY_SEED=
# Emergency kill switch: execution is allowed ONLY when this is exactly "true". Missing or invalid = blocked.
PAYMENT_EXECUTION_ENABLED=false
STALE_RESERVATION_TIMEOUT_SECONDS=300
BALANCE_POLL_INTERVAL_SECONDS=30
AGENT_TO_PAYMENT_GUARD_TOKEN=
# Optional second token for rotation (must differ from the first)
AGENT_TO_PAYMENT_GUARD_TOKEN_NEXT=
GUARD_HOST=
GUARD_PORT=
GUARD_BUSINESS_ID=
GUARD_PAYMENT_WAIT_SECONDS=
RECONCILE_INTERVAL_SECONDS=
GUARD_RATE_LIMIT_PER_MINUTE=
# Local development: pnpm db:up creates the database and its passwords in the gitignored .secrets/local-db.env, and
# pnpm guard:dev / pnpm m3:e2e assemble the guard connection in memory. Do not put those values here.

# ---- Agent process only (no database, no signer) ----
AI_PROVIDER=anthropic
# UNVERIFIED (spec 19.2): set to a current Sonnet-class model id from the provider's documentation.
AI_MODEL=<verify-current-anthropic-model-id>
AI_API_KEY=
AGENT_MODE=llm
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_PAYMENTS_PER_RUN=1
AGENT_REASON_MAX_CHARS=280
AGENT_RUN_TIMEOUT_SECONDS=60
# P1: empty disables the interval trigger
AGENT_SCHEDULE_INTERVAL_MINUTES=

# ---- Owner scripts only (run locally by the owner; never set in any deployed process) ----
OWNER_TREASURY_MASTER_SEED=
