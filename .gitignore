# Secrets: never commit. Only .env.example is tracked.
.env
.env.*
!.env.example
.secrets/
.local-pg/
*.seed
*wallets*.json

# Dependencies and build output
node_modules/
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo

# Local DB files
*.db
*.sqlite
*.sqlite3
.supabase/

# Logs and OS files
*.log
.DS_Store
Thumbs.db
# Secret material and local-only files (defence in depth; the secret-scan also rejects these names)
*.pem
*.key
*.p12
*.pfx
*.tsbuildinfo
.env*.local
npm-debug.log*
.vitest-cache/
.vitest/
# Local workflow artifacts and reference PDFs
.agents/
*.pdf

# Certificates belong in .secrets/, not the repo root
/*.crt
/*.cer
